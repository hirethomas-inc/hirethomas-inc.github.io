---
import { ChevronDown } from 'lucide-astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
  {items.map(it => (
    <details class="group px-6 py-5">
      <summary class="flex cursor-pointer items-center justify-between gap-4 text-left text-[15px] font-medium text-slate-900">
        {it.q}
        <ChevronDown class="chev size-4 shrink-0 text-slate-400 transition-transform" />
      </summary>
      <p class="mt-3 text-sm leading-6 text-slate-600" set:html={it.a} />
    </details>
  ))}
</div>
