---
import { Menu, X } from 'lucide-astro';
const links = [
  { href: '/#services', label: 'Services' },
  { href: '/pricewatch', label: 'Price Watch' },
  { href: '/#process', label: 'How it works' },
  { href: '/#faq', label: 'FAQ' },
];
---
<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/60">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5">
      <span class="grid size-8 place-items-center rounded-lg bg-slate-900 text-white shadow-sm">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v4H4z"/><path d="M4 12h10v8H4z"/><path d="M18 12v8"/></svg>
      </span>
      <span class="text-[15px] font-semibold tracking-tight text-slate-900">HireThomas</span>
    </a>
    <nav class="hidden items-center gap-8 md:flex">
      {links.map(l => <a href={l.href} class="text-sm font-medium text-slate-600 transition hover:text-slate-900">{l.label}</a>)}
    </nav>
    <div class="hidden md:block">
      <a href="/#quote" class="inline-flex h-9 items-center rounded-lg bg-slate-900 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800">Get a free sample</a>
    </div>
    <button id="nav-toggle" class="grid size-9 place-items-center rounded-lg text-slate-700 hover:bg-slate-100 md:hidden" aria-label="Open menu" aria-expanded="false">
      <Menu class="size-5" data-icon="open" />
      <X class="hidden size-5" data-icon="close" />
    </button>
  </div>
  <div id="nav-mobile" class="hidden border-t border-slate-200 bg-white md:hidden">
    <div class="space-y-1 px-4 py-3">
      {links.map(l => <a href={l.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">{l.label}</a>)}
      <a href="/#quote" class="mt-2 block rounded-lg bg-slate-900 px-3 py-2 text-center text-sm font-semibold text-white">Get a free sample</a>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-mobile');
  btn?.addEventListener('click', () => {
    const open = panel!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('[data-icon="open"]')!.classList.toggle('hidden', open);
    btn.querySelector('[data-icon="close"]')!.classList.toggle('hidden', !open);
  });
</script>
